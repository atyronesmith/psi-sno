$TTL    1800
$ORIGIN {{ cluster_domain }}.
@   IN  SOA  dns domains (
    2017042745 ; serial
    7200       ; refresh (2 hours)
    3600       ; retry (1 hour)
    1209600    ; expire (2 weeks)
    3600       ; minimum (1 hour)
    )
@   3600 IN NS {{ cluster_domain }}.

{% for cluster in item.value %}
api.{{ cluster.key }}.{{ cluster_domain }}.            IN  A   {{ cluster.value.ip }}
api-int.{{ cluster.key }}.{{ cluster_domain }}.        IN  A   {{ cluster.value.ip }}
*.apps.{{ cluster.key }}.{{ cluster_domain }}.         IN  A   {{ cluster.value.ip }}

{% endfor %}